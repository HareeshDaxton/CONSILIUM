# Deva/.env — created automatically on first run. Never share this file publicly.

# ngrok (local -> public HTTPS). Free account: https://dashboard.ngrok.com
# Your authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: your free static domain, so the URL never changes
# (e.g. pasta-hanky-grunt.ngrok-free.dev). Leave empty for a random URL.
NGROK_DOMAIN=

# ngrok = public URL via ngrok (default) | none = same Wi-Fi/LAN only
TUNNEL=ngrok
PORT=8100
# auto = NVIDIA GPU if PyTorch sees one, else CPU. "cuda" = refuse to run on CPU.
DEVICE=auto

# Shared secret with Hareesh's CONSILIUM (VISION_ENDPOINT_TOKEN on his side).
# Generated automatically on first run if empty.
CONSILIUM_VISION_TOKEN=
