# CONSILIUM environment template (ARCHITECTURE.md §8).
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Rule (AGENTS.md §8): secrets have NO defaults in code — the app fails fast
# when they are missing. The dev-only values below exist so the local compose
# stack boots; never use them outside your machine.

# ----- LLM (OpenAI) — REQUIRED secret -----
OPENAI_API_KEY=
LLM_MODEL_SPECIALIST=gpt-4o-mini-2024-07-18
LLM_MODEL_DIRECTOR=gpt-4o-mini-2024-07-18
# Critic: gpt-6-luna (a different model than every other agent, AGENTS.md §6).
# Accepted exception: no dated snapshot exists (doc/release_checklist.md).
# It is a reasoning model: temperature must be 1. Changing the critic model
# requires a fault-injection re-run (critic-fault-injection skill).
LLM_MODEL_CRITIC=gpt-6-luna
LLM_TEMPERATURE_SPECIALIST=0.2
LLM_TEMPERATURE_DIRECTOR=0.2
LLM_TEMPERATURE_CRITIC=1.0
LLM_REASONING_EFFORT_CRITIC=medium
LLM_VERBOSITY_CRITIC=low
LLM_MAX_OUTPUT_TOKENS_CRITIC=12000
# Critic prompt version (prompts/critic/vN.md); v4 is the released one.
CRITIC_PROMPT_VERSION=v4
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_CASE_TOKEN_BUDGET=100000
CRITIC_MAX_ROUNDS=3

# ----- Persistence / storage -----
# Compose overrides this to the postgres service; use this for a local DB.
DATABASE_URL=postgresql+asyncpg://consilium:consilium@localhost:5432/consilium
OBJECT_STORE_URI=file://./data/objects
# 32 bytes (or base64 of 32 bytes) — AES-256-GCM key for column-level encryption
# of clinical_notes.raw_redacted_text_enc (I-6). Back it up separately from the DB.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=dev-only-32-byte-key-00000000000
# docker-compose postgres + minio services (dev only)
POSTGRES_USER=consilium
POSTGRES_PASSWORD=consilium
POSTGRES_DB=consilium
MINIO_ROOT_USER=consilium
MINIO_ROOT_PASSWORD=consilium-dev-only

# ----- Vision (remote endpoint — I-13/I-14) -----
# http = call VISION_ENDPOINT_URL: Deva's GPU vision server (Deva/README.md),
# the compose fake-vision service, or a private HF Inference Endpoint.
# fake = no network (tests / offline dev stack only).
VISION_CLIENT_MODE=http
# The https URL Deva's run.bat prints (ngrok), or http://<LAN-IP>:8100 on the same Wi-Fi.
VISION_ENDPOINT_URL=http://localhost:8100
# = CONSILIUM_VISION_TOKEN in Deva/.env
VISION_ENDPOINT_TOKEN=dev-fake-token
# Must equal configs/models.yaml endpoint.pinned_revision (scripts/run_app.py
# fills it in automatically when left empty).
VISION_PINNED_REVISION=
VISION_TIMEOUT_S=120

# ----- Guardrails model rail (§14) -----
# nemo = real NeMo Guardrails (needs the optional nemoguardrails package).
# passthrough = local dev only; deterministic input/output checks still run.
RAILS_ENGINE=nemo

# ----- Auth — REQUIRED secret -----
# HS* secrets must be >= 32 bytes. Prod (OIDC): JWT_ALGORITHM=RS256 + JWT_PUBLIC_KEY.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
# JWT_PUBLIC_KEY=
# JWT_ISSUER=
# JWT_AUDIENCE=
API_DOCS_ENABLED=false

# ----- Google sign-in (review UI) -----
# Public OAuth web client ID (Google Cloud console → Credentials). Add
# http://localhost:5173 to its "Authorized JavaScript origins". Leave empty to
# disable Google sign-in.
GOOGLE_CLIENT_ID=
# Comma-separated Google account emails per role. A verified Google account in
# neither list is refused (fail closed). Sessions are CONSILIUM tokens signed
# with JWT_SECRET and last SESSION_TTL_MINUTES. A clinician cannot sign a case
# they submitted, so use a second account to sign your own submissions.
GOOGLE_CLINICIANS=
GOOGLE_SUBMITTERS=
SESSION_TTL_MINUTES=480

# ----- Observability (optional in dev) -----
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_ENDPOINT=

# ----- Worker (Postgres-backed job queue) -----
WORKER_POLL_INTERVAL_S=1.0
WORKER_MAX_ATTEMPTS=3
# Worker /metrics port scraped by Prometheus (0 disables).
WORKER_METRICS_PORT=9100

# ----- Operations (Phase 14) -----
# Privileged DB role for scripts/retention.py ONLY (the serving role cannot
# delete from append-only tables). Never give this to the API/worker.
RETENTION_DATABASE_URL=
# Rollback/incident switch: true = POST /v1/cases returns 503 (review keeps working).
INTAKE_FROZEN=false
