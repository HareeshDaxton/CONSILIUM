# CONSILIUM environment template (ARCHITECTURE.md §8).
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Rule (AGENTS.md §8): secrets have NO defaults in code — the app fails fast
# when they are missing. The dev-only values below exist so the local compose
# stack boots; never use them outside your machine.

# ----- LLM (OpenAI) — REQUIRED secret -----
OPENAI_API_KEY=
LLM_MODEL_SPECIALIST=gpt-4o-mini-2024-07-18
LLM_MODEL_DIRECTOR=gpt-4o-mini-2024-07-18
LLM_MODEL_CRITIC=gpt-4o-mini-2024-07-18
LLM_TEMPERATURE_SPECIALIST=0.2
LLM_TEMPERATURE_DIRECTOR=0.2
LLM_TEMPERATURE_CRITIC=0.0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_CASE_TOKEN_BUDGET=100000
CRITIC_MAX_ROUNDS=3

# ----- Persistence / storage -----
# Compose overrides this to the postgres service; use this for a local DB.
DATABASE_URL=postgresql+asyncpg://consilium:consilium@localhost:5432/consilium
OBJECT_STORE_URI=file://./data/objects
POSTGRES_USER=consilium
POSTGRES_PASSWORD=consilium
POSTGRES_DB=consilium
MINIO_ROOT_USER=consilium
MINIO_ROOT_PASSWORD=consilium-dev-only

# ----- Vision (remote endpoint — I-13/I-14) -----
# fake = no network (tests/dev without the stack). http = call VISION_ENDPOINT_URL
# (in the compose stack this points at the fake-vision service; in prod at the
# private HF Inference Endpoint).
VISION_CLIENT_MODE=fake
VISION_ENDPOINT_URL=http://localhost:8100
VISION_ENDPOINT_TOKEN=dev-fake-token
VISION_PINNED_REVISION=sha256:fake/dev-fake-000
VISION_TIMEOUT_S=120
FAKE_VISION_REVISION=sha256:fake/dev-fake-000

# ----- Observability (optional in dev) -----
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_ENDPOINT=

# ----- Auth — REQUIRED secret -----
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
